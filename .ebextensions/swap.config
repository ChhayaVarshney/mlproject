commands:
  create_swap:
    command: |
      # Create a 2GB swap file only if it doesn't already exist
      if [ ! -f /swapfile ]; then
        echo "Creating swap file..."
        fallocate -l 2G /swapfile
        chmod 600 /swapfile
        mkswap /swapfile
        swapon /swapfile
        echo "Swap file created and activated."
      else
        echo "Swap file already exists. Skipping creation."
      fi
